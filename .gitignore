# secrets — the only copy lives on the machine that runs the service
.env
.env.*
!.env.example

# build + deps
node_modules/
dist/
*.tsbuildinfo

# run artifacts: every extraction / apply writes under runs/<id>/ (see docs/ARCHITECTURE.md)
runs/

# the datasheet corpus (2.9 GB). Canonical copy: /var/lib/netzspec-api/cache on the VPS
scraper/cache/
scraper/__pycache__/
scraper/**/__pycache__/
scraper/ledger.jsonl

# scratch
*.log
tmp/

# python bytecode
__pycache__/

# graphify knowledge graph (rebuilt locally; never committed)
graphify-out/

# Reviewer handovers carry a read-only token and an API key. Gitignored BEFORE the directory exists
# (brief STEP A.1, 27 Sep 2026): a secret that reaches a commit is a secret in the history for ever.
docs/reviewer/**/handover.md
docs/reviewer/**/*.zip
docs/reviewer/**/*.csv
docs/reviewer/**/*.gz
