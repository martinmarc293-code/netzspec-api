const ETH_NO_POE_STACK = A.ETH.filter((s) => !/^(poe_standard|poe_budget|poe_ports|stackable|stacking_bandwidth)(:|$)/.test(s));

export type KindDef = { category: string; kind: string; target: string; cups: Cup[]; note?: string;
  roles?: Record<string, { add: Cup[]; demote: string[]; note?: string }> };

const k = (category: string, kind: string, target: string, blocks: [string, string[]][], note?: string): KindDef =>
  ({ category, kind, target, cups: compose(...blocks), note });
