// The reviewer's spec v2 Part I.4 archetypes + Part II deltas, transcribed as data (kind-layer III.0, agent/kindlayer-A).
// Cup syntax: "key" required · "key:opt" optional · "key:g=gate" pending on gate · "a|b" either key evidences the cup
//             ":new" marks a key the spec calls NEW. Later entries override earlier ones with the same cup name.
export type Cup = { cup: string; keys: string[]; status: "req" | "pending" | "opt"; gate?: string; isNew: boolean; origin: string };

export function parse(spec: string, origin: string): Cup {
  const [head, ...mods] = spec.split(":");
  let status: Cup["status"] = "req"; let gate: string | undefined; let isNew = false;
  for (const m of mods) {
    if (m === "opt") status = "opt";
    else if (m === "new") isNew = true;
    else if (m.startsWith("g=")) { status = "pending"; gate = m.slice(2); }
    else if (m === "req") status = "req";
    else throw new Error(`bad cup modifier ${m} in ${spec}`);
  }
  return { cup: head, keys: head.split("|"), status, gate, isNew, origin };
}
export function compose(...blocks: [string, string[]][]): Cup[] {
  const out = new Map<string, Cup>();
  for (const [origin, specs] of blocks) for (const s of specs) { const c = parse(s, origin); out.set(c.cup, c); }
  return [...out.values()];
}

