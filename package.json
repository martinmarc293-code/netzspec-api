{
  "name": "netzspec-api",
  "version": "0.1.0",
  "private": true,
  "description": "Network-hardware specification API: every part number, every fact with its source.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/run-tests.ts",
    "test:db": "tsx scripts/run-tests.ts --db",
    "migrate": "tsx db/migrate.ts",
    "ingest": "tsx src/pipeline/cli.ts",
    "fill:nightly": "bash scripts/fill-nightly.sh",
    "mould:verify": "tsx scripts/mould-verify.mts",
    "mould:contract": "tsx scripts/mould-contract.mts",
    "mould:contract:check": "tsx scripts/mould-contract.mts --check"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@sinclair/typebox": "^0.34.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "mongodb": "^6.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
