# Copy to .env — never commit. On the VPS the real file is /root/netzspec-api/.env
DATABASE_URL=postgres://netzspec_api:PASSWORD@127.0.0.1:5432/netzspec
PORT=3021
HOST=127.0.0.1
# absolute base for images served by Caddy from IMAGE_DIR
PUBLIC_BASE_URL=https://api.netzspec.com
IMAGE_DIR=/var/lib/netzspec-api/images
CACHE_DIR=/var/lib/netzspec-api/cache
RUNS_DIR=/var/lib/netzspec-api/runs
LOG_LEVEL=info
